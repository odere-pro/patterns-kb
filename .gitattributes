# Derived artifacts. Every one is regenerated by `make all` from the pages, which are the
# real source; `make check` fails if any is stale. Marking them keeps a 15,000-line
# graph.json diff out of review and out of GitHub's language stats. They are still
# committed and must stay committed — the site is deployed as-is and must open from
# file://, so a clone with no build step has to work.
site/assets/graph.json     linguist-generated=true -diff
site/assets/catalog.json   linguist-generated=true -diff
site/assets/catalog.js     linguist-generated=true -diff
site/assets/graphdata.js   linguist-generated=true -diff

# Vendored third-party libraries — update by replacing the file, never by editing.
scripts/vendor/**          linguist-vendored=true
site/assets/vendor/**      linguist-vendored=true
