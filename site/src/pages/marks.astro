---
// The "My marks" page, at /marks.html: the reader's favourites, the editors'
// picks and the practiced pages in one place. A Starlight page outside the
// content folder, since it is a tool and no page of the knowledge base: it has
// no source under docs/ and no row in the structure file. The header links to
// it (SocialIcons), the phone menu opens on it, and its trail is Home › My
// marks (lib/routes.ts, TOOL_ROUTES). The route middleware gives it the
// sidebar that carries the phone menu.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Marks from '../components/Marks/Marks.astro';

const frontmatter = {
  title: 'My marks',
  description:
    'The pages you starred, the editors’ picks and the pages you practiced, kept in this browser, with export, import and reset.',
  area: 'patterns',
  owner: 'Oleksandr Derechei',
  tags: ['composition'],
  status: 'stable',
  tableOfContents: false,
};
---

<StarlightPage frontmatter={frontmatter}>
  <Marks />
</StarlightPage>
