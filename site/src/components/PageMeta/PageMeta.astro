---
// "What a machine reads here" — the header button and its panel.
//
// Every page carries structured metadata a human never sees: the kb:* meta
// tags, the schema.org JSON-LD, and the entry those become in dist/index.json.
// This puts that behind one button, because metadata nobody can look at is
// metadata nobody maintains.
//
// The panel ships EMPTY. Compiling the values into this markup as a <dl> and
// a pretty-printed JSON block would put a second copy of the JSON-LD and a
// third of the meta tags in the page text of all 18 pages. The page layer
// carries the data once, in <head>; page-meta.client.ts fills the panel from
// those very tags when the page loads. That is also the honest version of the
// old "the panel cannot show something other than what was emitted" promise:
// it now shows literally what the page carries, not a parallel computation.
---

<button
  type="button"
  class="kb-meta-button"
  data-kb-meta-open
  data-kb-skip
  title="What a machine reads on this page"
  aria-label="What a machine reads on this page"
>
  <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M8 5H6.5A1.5 1.5 0 0 0 5 6.5v3A2.5 2.5 0 0 1 2.5 12 2.5 2.5 0 0 1 5 14.5v3A1.5 1.5 0 0 0 6.5 19H8" />
    <path d="M16 5h1.5A1.5 1.5 0 0 1 19 6.5v3a2.5 2.5 0 0 0 2.5 2.5 2.5 2.5 0 0 0-2.5 2.5v3a1.5 1.5 0 0 1-1.5 1.5H16" />
  </svg>
</button>

<dialog class="kb-meta-dialog" data-kb-meta-dialog aria-label="Page metadata" data-kb-skip>
  <header class="kb-meta-dialog-head">
    {/* A <p>, not a heading: the dialog is chrome, and this markup renders
        before the page's <h1> — as an h2 it put three chrome headings ahead
        of every page title in the document outline (the dialog renders twice,
        see CLAUDE.md). The dialog is named by its aria-label. */}
    <p class="kb-meta-dialog-title">What a machine reads here</p>
    <button type="button" class="kb-meta-close" data-kb-meta-close aria-label="Close">✕</button>
  </header>

  <p class="kb-card-desc">
    Read live from this page's own <code>&lt;meta&gt;</code> tags and JSON-LD
    block — the same values that become this page's entry in the site's
    machine-readable index.
  </p>

  <dl class="kb-meta-list" data-kb-meta-list></dl>

  <p class="kb-kicker">JSON-LD (schema.org TechArticle)</p>
  <pre class="kb-meta-json" data-kb-meta-json><code></code></pre>

  <p class="kb-card-desc">
    Every page, as one manifest: <a href="/index.json">index.json</a>
  </p>
</dialog>
