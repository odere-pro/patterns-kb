---
// "I have worked through this page": a check toggle per page, a running
// count on a hub, and a count per tour. PageTitle puts a toggle under a page's
// title, SectionHub one on each hub row and the count above the rows;
// practiced.client.ts keeps every toggle for one page in step, remembers them,
// and counts.
//
// A tour is a theme page's walk (docs/data/learning-paths.json). Its page list
// is baked into the markup as a hook, `data-kb-practiced-tour="a b c"`, and the
// browser counts it against the stored marks, so the count needs no server and
// works from a folder. `tour` is one theme page's count, skip-marked chrome that
// goes under the title, never inside the knowledge region; `tours` is the home
// page's list of every tour, each shown only once the reader has marked a page
// of it. The list names each tour and does not link it: the link gate holds a
// page to exactly one hub, and the home page counts as one, so a link here to
// a theme page would be a second.
//
// A separate store from Favourites, with a separate meaning: favourite is "I
// want this near the top", practiced is "I have used this in real work" — the
// title says so, and so do the marks page and the home page. Markup only; the
// classes are in practiced.css.
import { readTours } from '../../lib/tours';

interface Props {
  /** The page's slug: the store's key. Absent with `count`. */
  slug?: string;
  /** The page's title, for the accessible name. */
  name?: string;
  /** A bare check, for a hub row. */
  compact?: boolean;
  /** The hub's count of the rows it lists that are practiced, in place of a toggle. */
  count?: boolean;
  /** The slugs of the pages one tour walks: that tour's "n of m practiced", in place of a toggle. */
  tour?: string[];
  /** Every tour, as the home page's list of the ones the reader has started. */
  tours?: boolean;
}

const { slug = '', name = '', compact = false, count = false, tour, tours = false } = Astro.props;
const all = tours ? readTours() : [];
---

{
  tours ? (
    <section class="kb-practiced-tours" data-kb-practiced-tours hidden>
      <h2 class="kb-kicker">Tours you have started</h2>
      <ul>
        {all.map((t) => (
          <li data-kb-practiced-tour={t.slugs.join(' ')} hidden>
            <span>{t.label}</span>
            <span class="kb-practiced-count" data-kb-practiced-tour-text />
          </li>
        ))}
      </ul>
    </section>
  ) : tour !== undefined ? (
    <p
      class="kb-practiced-count"
      data-kb-skip
      data-kb-practiced-tour={tour.join(' ')}
      role="status"
      aria-live="polite"
      title="Practiced means you have used a page in real work; your checks stay in this browser."
    />
  ) : count ? (
    <p
      class="kb-practiced-count"
      data-kb-practiced-count
      role="status"
      aria-live="polite"
      title="Practiced means you have used a page in real work; your checks stay in this browser."
    />
  ) : (
    <button
      type="button"
      class:list={['kb-practiced', { 'kb-practiced--compact': compact }]}
      data-kb-practiced={slug}
      aria-pressed="false"
      aria-label={`Practiced: ${name}`}
      title={compact ? 'Practiced' : 'Mark when you have used this in real work'}
    >
      <svg class="kb-practiced-check" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3.5" y="3.5" width="17" height="17" rx="3" />
        <path class="kb-practiced-tick" d="M8 12.5l3 3 5-6.5" />
      </svg>
      {!compact && <span>Practiced</span>}
    </button>
  )
}
