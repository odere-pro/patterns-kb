---
// The body of a hub page: one entry per child page, from the groups the hub
// generator (tools/src/gen/gen-site-hubs.ts) assembled out of child frontmatter.
// The root hub hands it groups by hand — same entries, same order rules, and
// the one caller that asks for cards. Markup only: the classes are in
// section-hub.css beside this file, and plain anchors mean the post-build pass
// makes them file://-safe like everything.
//
// The group label is an <h2>, and that is a hub page's outline. It was a <p>
// once: every generated hub shipped with exactly one heading, its own title, so
// the site's primary navigation surfaces had no structure at all below it —
// nothing to jump between with a screen reader's heading list, nothing for the
// reading rail. It looks exactly as it did; section-hub.css pins the
// appearance, and it can because Starlight's markdown heading rules sit in
// @layer starlight.content while customCss is unlayered, so an unlayered rule
// wins whatever it weighs.
//
// A list row also carries what the reader does with it: the keys the filter
// bar above the list reads (`data-kb-facet-keys`, a hook: the row is classed),
// and, for a page, its favourite star and practiced check. A nested area's
// row has no slug, so it gets neither — they are marks on pages. The bar and
// the practiced count lead the list; the splash's cards have none of it.
//
// Below that <h2> the two variants say what an entry is in different ways, and
// both are honest. A card is a destination and its title is an <h3>, one more
// level of the same outline. A list row is a link in a list of links, which a
// screen reader already enumerates on its own — an <h3> per row would put forty
// headings in the rail of a page whose whole content is its links, and the
// accessible name of each would then be a paragraph rather than a page title.
//
// The list is an <ol> because its order means something: the generator ranks
// entries in the structure file's reading order, so the rows are that order and the numbers
// are that order stated rather than implied. The cards are unnumbered — the
// splash offers journeys to choose between, and numbering a choice ranks it.
//
// A row's children are an <a> and two <span>s under one <span>, and nothing
// else. That is not a style decision: Starlight's list-spacing rule is keyed on
// `:has(> li > :not(a, strong, em, del, span, input, code, br, script, ol, ul))`
// and hands every row 1.25rem of bottom margin the moment one holds a <p>.
// The wrapping <span> is where the row's grid lives, because `display: grid` on
// the <li> would replace `list-item` and take its number away with it.
//
// The fallback labels are why every hub has an h2 rather than most of them. The
// generator labels a group of children sharing a topic tag; the pages whose
// topic no sibling shares travel together in one anonymous group, which on a
// small folder is still the whole page. An outline that exists on the hubs with
// topic groups and not on the others is not an outline.
//
// Which of the two that group gets is a question about position, and only the
// component knows the position. Groups are ordered by reading order, so the anonymous
// one leads on some hubs and trails on others; "In this section" heading the
// second half of a page claims a scope it does not have, and the heading a
// reader needs there says the rest.
import Facets from '../Facets/Facets.astro';
import Favourites from '../Favourites/Favourites.astro';
import Practiced from '../Practiced/Practiced.astro';
import { entryKeys } from '../../lib/facets';

import type { HubGroup } from '../../lib/site-types';

interface Props {
  groups?: HubGroup[];
  /**
   * `list` is a section hub's table of contents, and the default: a hub's whole
   * job is "here is what is inside, pick one", and a grid of bordered cards
   * spends a screen and a half saying it. `cards` is the splash, where the five
   * journeys ARE the page and each one is a destination rather than an entry.
   *
   * Defaulting to the list is what keeps this a choice made once, by the one
   * file a person authored: both generators emit hubs and neither has to know
   * the prop exists.
   */
  variant?: 'cards' | 'list';
}

/** What the generator's one unlabelled group is called out loud, leading. */
const FALLBACK_LABEL = 'In this section';

/** And the same group when a labelled one has already had its say. */
const FALLBACK_LABEL_REST = 'The rest of this section';

const { groups = [], variant = 'list' } = Astro.props;

/**
 * Where each group's numbering picks up, so one count runs down the page.
 *
 * The list is in reading order, and the number is what says so out loud: this
 * is a contents page, and these are its pages in the order they are meant to
 * be read. The groups are stretches of that one order, so a second `1.`
 * halfway down would say the count started again.
 *
 * `<ol start>` rather than a CSS counter across siblings, because a counter
 * cannot be read back: the position is content, and a reader with no
 * stylesheet still gets it.
 */
let next = 1;
const starts = groups.map((g) => {
  const at = next;
  next += g.pages.length;
  return at;
});

const pages = groups.some((g) => g.pages.some((p) => p.slug !== undefined));
---

{variant === 'list' && pages && <Practiced count />}
{variant === 'list' && <Facets groups={groups} />}

{
  groups.map((g, i) => (
    <section class="kb-hub-group">
      <h2 class="kb-kicker">{g.label || (i === 0 ? FALLBACK_LABEL : FALLBACK_LABEL_REST)}</h2>
      {variant === 'cards' ? (
        <div class="kb-card-grid">
          {g.pages.map((p) => (
            <a class="kb-card" href={p.href}>
              <h3 class="kb-card-title">
                {p.anchors?.map((id) => (
                  <span id={id} />
                ))}
                {p.title}
              </h3>
              <span class="kb-card-desc">{p.description}</span>
              <span class="kb-card-meta">
                {p.count !== undefined && <span class="kb-card-count">{p.count}</span>}
                {p.status && p.status !== 'stable' && (
                  <span class={`kb-status kb-status--${p.status}`}>{p.status}</span>
                )}
              </span>
            </a>
          ))}
        </div>
      ) : (
        <ol class="kb-hub-list" start={starts[i]}>
          {g.pages.map((p) => (
            <li class="kb-hub-item" data-kb-facet-keys={entryKeys(p).join(' ')}>
              <span class="kb-hub-row">
                <a class="kb-hub-link" href={p.href}>
                  {p.title}
                </a>
                <span class="kb-card-desc">{p.description}</span>
                <span class="kb-card-meta">
                                    {p.status && p.status !== 'stable' && (
                    <span class={`kb-status kb-status--${p.status}`}>{p.status}</span>
                  )}
                  {p.slug !== undefined && <Favourites slug={p.slug} name={p.title} authored={p.favourite === true} compact />}
                  {p.slug !== undefined && <Practiced slug={p.slug} name={p.title} compact />}
                </span>
              </span>
            </li>
          ))}
        </ol>
      )}
    </section>
  ))
}
