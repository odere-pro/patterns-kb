---
// The prerequisite card (spec kb.learning.prerequisites, card;
// prerequisites-C8): what to read before this page, then what sits beside it,
// read from docs/data/prerequisites.json by tools/src/lib/site-prerequisites.ts.
// MarkdownContent injects it at the top of the knowledge region; no page
// carries markup for it.
//
// Knowledge, not chrome: no skip marker. The outer <div> is the data block —
// class-free, carrying only the two facts, each list's ids joined by commas —
// and everything inside it is paint the reader reads through. No heading: the
// card is no section of the page, and a heading here would join the page's
// outline, its manifest headings and its table of contents. Markup only; the
// classes are in prerequisite-card.css beside this file.
//
// Each link carries the one-line reason the relation gives for it, worded from
// this page's side of the edge (../../lib/relation-notes.ts). A row shows its
// first five links; the rest sit in a <details> opened by "See all N", the
// disclosure the site already uses, so nothing needs a script.
import { cardFacts, loadCards } from '../../../../tools/src/lib/site-prerequisites';
import { loadNotes, reasonFor } from '../../lib/relation-notes';
import { repoRoot } from '../../lib/repo-root';
import { routeOf } from '../../lib/routes';

/** How many links a row shows before the rest fold behind "See all". */
const SHOWN = 5;

interface Props {
  /** The page's route; the current page's when absent. */
  route?: string;
}

const route = Astro.props.route ?? routeOf(Astro.locals.starlightRoute.entry.filePath);
const card = route === null ? undefined : loadCards(repoRoot()).get(route);
const facts = card === undefined ? undefined : cardFacts(card);
const notes = loadNotes(repoRoot());
const slug = route === null ? '' : (route.split('/').pop() ?? '').replace(/\.html$/, '');
/** One link with the reason this page gives for it, when the relation has one. */
const withReason = (l: { id: string; label: string; definition: string; route: string }) => ({
  ...l,
  why: reasonFor(notes, slug, l.id),
});
const rows =
  card === undefined
    ? []
    : [
        { label: 'Read first', links: card.requires },
        { label: 'Related', links: card.related },
      ]
        .filter((r) => r.links.length > 0)
        .map((r) => ({
          label: r.label,
          total: r.links.length,
          first: r.links.slice(0, SHOWN).map(withReason),
          rest: r.links.slice(SHOWN).map(withReason),
        }));
---

{
  card !== undefined && facts !== undefined && (
    <div data-requires={facts.requires} data-related={facts.related}>
      <aside class="kb-prereq not-content" aria-label="Before and beside this page">
        {rows.map((r) => (
          <div class="kb-prereq-row">
            <span class="kb-prereq-label">{r.label}</span>
            <div class="kb-prereq-items">
              <ul class="kb-prereq-list">
                {r.first.map((l) => (
                  <li>
                    <a href={l.route} title={l.definition}>
                      {l.label}
                    </a>
                    {l.why && <span class="kb-prereq-why">{l.why}</span>}
                  </li>
                ))}
              </ul>
              {r.rest.length > 0 && (
                <details class="kb-prereq-more">
                  <summary>See all {r.total}</summary>
                  <ul class="kb-prereq-list">
                    {r.rest.map((l) => (
                      <li>
                        <a href={l.route} title={l.definition}>
                          {l.label}
                        </a>
                        {l.why && <span class="kb-prereq-why">{l.why}</span>}
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </div>
          </div>
        ))}
      </aside>
    </div>
  )
}
