---
// The sidebar, trimmed to the reader's branch: the top-level areas, with the
// area holding this page open down to its pages (./current-branch.ts says
// how). Starlight's own list and footer render it, so it looks and behaves
// like upstream's.
//
// Upstream wraps the list in its state persister, which restores each
// group's open state by position from the previous page. The trimmed list
// has a different shape on every branch, so a position from one page would
// open or close the wrong group on the next: the list renders bare, and the
// bundle's SidebarScroll keeps the current page in view instead.
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';

import { isMenuOnly, routeOf } from '../../lib/routes';
import { currentBranch } from './current-branch';

const { sidebar: full, entry } = Astro.locals.starlightRoute;
const sidebar = currentBranch(full);
const menuOnly = isMenuOnly(routeOf(entry.filePath));
---

{/* The phone menu opens on the reader's own controls — My marks, the theme —
    and then the page tree: they come first, where a thumb reaches them. */}
<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

{
  /* A page with no tree of its own (home, marks, not found) holds the sidebar
     for the phone menu alone; sidebar.css hides the pinned pane on a desktop. */
  menuOnly && <span data-kb-menu-only hidden />
}

<SidebarSublist sublist={sidebar} />
