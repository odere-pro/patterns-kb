---
// Where a reader goes from the end of a page: the page before, the hub above,
// the page after. It stands in Starlight's Pagination slot, below the page.
//
// Before and after are Starlight's own answer: its pagination walks the
// sidebar, and the sidebar is the structure file's reading order
// (astro.config.mjs builds it from docs/data/site-structure.json), so they are
// the order each hub lists its pages in. Up is the hub that holds the page, or
// for a hub the one above it (../../lib/routes.ts, upOf). A hub link is named
// by its area, never by the sidebar's "Overview" (pagerLabel), the next link
// says which area it stays in ("Next in Resilience"), and a page
// before that is the hub above is shown once, as up. A hub drops a neighbour of
// another kind of page.
//
// The home page gets none of it: it is where every trail starts. The bar is
// chrome, skip-marked, outside the knowledge region, and plain anchors: the
// post-build pass makes the hrefs relative, so it works from a folder too.
// Markup only; the classes are in next-steps.css beside this file.
import {
  areaLabel,
  areaOfRoute,
  isHub,
  isTool,
  NOT_FOUND,
  pagerLabel,
  routeOf,
  topAreaOf,
  topAreaOfRoute,
  upOf,
} from '../../lib/routes';

const { entry, pagination } = Astro.locals.starlightRoute;
const route = routeOf(entry.filePath);
// The home page is where every trail starts, and the not-found page has no
// place to go on from. The marks page sits outside the reading order: it has
// an up (the home page) and no before or after.
const home = route === null || route === '/index.html' || route === NOT_FOUND;
const tool = isTool(route);
const named = (link: { href: string; label: string } | undefined) =>
  link === undefined ? null : { href: link.href, label: pagerLabel(link.href, link.label) };
const up = home ? null : upOf(entry.data.area, route);
// A hub's first page would show its hub twice, as "before" and as "up": up
// says it, and before is left empty.
// A hub's neighbours in the sidebar can belong to another kind of page (the
// hazards before the case studies); there before and after are not a reading
// order, so a hub links only a neighbour of its own kind.
const kind = topAreaOf(entry.data.area);
const sameKind = (link: { href: string } | undefined) =>
  !isHub(route) || link === undefined || topAreaOfRoute(link.href) === kind;
const prev =
  home || tool || pagination.prev?.href === up?.href || !sameKind(pagination.prev) ? null : named(pagination.prev);
const next = home || tool || !sameKind(pagination.next) ? null : named(pagination.next);
// "Next in Resilience" when the page after stays in this page's area, plain
// "Next" when the walk crosses into another area.
const nextArea =
  next === null || pagination.next === undefined || areaOfRoute(pagination.next.href) !== entry.data.area
    ? undefined
    : areaLabel(entry.data.area);
---

{
  (prev || up || next) && (
    <nav class="kb-pager" aria-label="Page navigation" data-kb-skip>
      {prev ? (
        <a class="kb-pager-link kb-pager-prev" href={prev.href} rel="prev">
          <span class="kb-pager-dir">← Previous</span>
          <span class="kb-pager-title">{prev.label}</span>
        </a>
      ) : (
        <span />
      )}
      {up ? (
        <a class="kb-pager-link kb-pager-up" href={up.href}>
          <span class="kb-pager-dir">↑ Up</span>
          <span class="kb-pager-title">{up.label}</span>
        </a>
      ) : (
        <span />
      )}
      {next ? (
        <a class="kb-pager-link kb-pager-next" href={next.href} rel="next">
          <span class="kb-pager-dir">{nextArea === undefined ? 'Next' : `Next in ${nextArea}`} →</span>
          <span class="kb-pager-title">{next.label}</span>
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}
