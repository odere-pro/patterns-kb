---
// The filter bar above a hub's list: one rail per tag facet, a chip per value the hub's entries share (src/lib/facets.ts),
// a "Show:" rail holding the Starred chip (the reader's stars plus the
// editors' picks), and a "Clear filters" control that appears while any filter
// is on. facets.client.ts does the filtering on the page, from the keys
// SectionHub writes on each row (`data-kb-facet-keys`).
//
// Controls, not knowledge, but inside the knowledge region, where nothing may
// be skip-marked: a reader reads through them as decoration. They do nothing
// with no script, so the noscript rule in Head.astro takes them away.
// Markup only; the classes are in facets.css.
import { facetRails } from '../../lib/facets';

import type { HubGroup } from '../../lib/site-types';

interface Props {
  groups: HubGroup[];
}

/** Below this many entries a list is read at a glance, and a filter is noise. */
const MIN_ENTRIES = 4;

const { groups } = Astro.props;
const entries = groups.flatMap((g) => g.pages);
const rails = facetRails(entries);
const favourites = entries.some((e) => e.slug !== undefined);
const shown = entries.length >= MIN_ENTRIES && (rails.length > 0 || favourites);
---

{
  shown && (
    <div class="kb-facets not-content" data-kb-facets role="group" aria-label="Filter this list">
      {rails.map((rail) => (
        <div class="kb-facet-rail">
          <span class="kb-facet-rail-label">{rail.label}</span>
          {rail.chips.map((chip) => (
            <button type="button" class="kb-facet-chip" data-kb-facet={chip.key} aria-pressed="false">
              {chip.label}
            </button>
          ))}
        </div>
      ))}
      {favourites && (
        <div class="kb-facet-rail" data-kb-facet-show>
          <span class="kb-facet-rail-label">Show:</span>
          <button
            type="button"
            class="kb-facet-chip"
            data-kb-facet-favourites
            aria-pressed="false"
            title="Pages you starred, plus the editors' picks"
          >
            Starred
          </button>
        </div>
      )}
      <div class="kb-facet-foot">
        <p class="kb-facet-status" data-kb-facet-status role="status" aria-live="polite" />
        <button type="button" class="kb-facet-clear" data-kb-facet-clear hidden>Clear filters</button>
      </div>
    </div>
  )
}
