---
// The home page's way in: one card per top-level area, read from the one
// structure source (docs/data/site-structure.json) and placed by
// tools/src/lib/site-routes.ts, so the home page never holds a second copy of
// an area's name, summary or route. Markup is SectionHub's card variant. A
// `link` area's card opens its one page, there being no hub; an unpublished
// (`none`) area has no card.
import structureFile from '../../../../docs/data/site-structure.json';
import { linkPage, navOf, placedHubs, type Structure } from '../../../../tools/src/lib/site-routes';
import SectionHub from '../SectionHub/SectionHub.astro';
import { atlasAnchors } from '../../lib/atlas';
import { countLine } from '../../lib/counts';
import type { HubGroup } from '../../lib/site-types';

const structure = structureFile as Structure;
const hubs = new Map(placedHubs(structure).map((h) => [h.area, h.route]));
const groups: HubGroup[] = [
  {
    label: 'Where to start',
    pages: structure.areas
      .filter((a) => a.nestUnder === undefined && navOf(a) !== 'none')
      .map((a) => ({
        href: (navOf(a) === 'link' ? linkPage(structure, a.id)?.route : hubs.get(a.id)) as string,
        title: a.label,
        description: a.hub.description,
        // The HTML home page's section ids, so a link or bookmark into it
        // still lands on the card that answers it.
        anchors: atlasAnchors(a.id),
        // Counted from the structure rows at build time, never typed.
        count: countLine(structure, a.id) ?? undefined,
      })),
  },
];
---

<SectionHub groups={groups} variant="cards" />
