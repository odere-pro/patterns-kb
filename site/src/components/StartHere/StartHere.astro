---
// The home page's guided way in: a few short tracks, each an ordered list of
// themes from the gentlest to the hardest, so a new reader has somewhere to
// begin that is not the whole site map. Tracks and tiers come from
// docs/data/tracks.json (src/lib/tracks.ts joins them to the tours), so the
// home page holds no second copy of a theme's name.
//
// Each step is a real link to its theme page. The link gate counts a hub's
// links only in the knowledge region up to the element with id="next-steps",
// and this block's heading carries that id, so the block sits after the site
// map on the home page and its links are onward links, not a second hub for a
// theme. One more link goes to the Themes hub. Each track carries the
// practiced count of the pages its tours walk (practiced.client.ts counts the
// baked slug list against the reader's marks). The block is inside the
// knowledge region, so it carries no skip marker (the absence gate refuses one
// there). Markup only; classes are in start-here.css.
import { startTracks, TIER_LABEL } from '../../lib/tracks';

const tracks = startTracks();
---

{
  tracks.length > 0 && (
    <section class="kb-start-here not-content" aria-labelledby="next-steps">
      <h2 id="next-steps" class="kb-kicker">Start here</h2>
      <p class="kb-start-here-lead">
        New to this? Pick a track and read its themes top to bottom, easiest first. Each step is that
        theme's page, or <a href="/themes.html">browse every theme</a>.
      </p>
      <ol class="kb-start-here-tracks">
        {tracks.map((t) => (
          <li class="kb-start-here-track" data-kb-practiced-tour={t.slugs.join(' ')}>
            <h3 class="kb-start-here-title">{t.label}</h3>
            <p class="kb-start-here-blurb">{t.blurb}</p>
            <ol class="kb-start-here-steps">
              {t.steps.map((s) => (
                <li>
                  <a class="kb-start-here-step" href={s.route}>
                    {s.label}
                  </a>
                  {s.tier !== undefined && <span class="kb-start-here-tier">{TIER_LABEL[s.tier]}</span>}
                </li>
              ))}
            </ol>
            <span class="kb-practiced-count" data-kb-practiced-tour-text />
          </li>
        ))}
      </ol>
    </section>
  )
}
