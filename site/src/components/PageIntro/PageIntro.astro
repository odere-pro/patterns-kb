---
// The intro line every page opens with: the purpose line, read from the
// frontmatter the metadata contract already requires. Injected by the
// PageTitle override, so no page carries markup for it. Markup only: the
// classes are in page-intro.css beside this file.
//
// Where the body's first paragraph opens with the purpose line word for word
// (../../lib/intro.ts), the intro is left out: the reader meets the sentence
// once, in the lead, rather than twice in two lines.
import { leadRepeats } from '../../lib/intro';

const { entry } = Astro.locals.starlightRoute;
const data = entry.data;
const repeated = leadRepeats(data.description, (entry as { body?: string }).body);
---

{
  !repeated && (
    <p class="kb-page-intro">
      <span class="kb-page-intro-purpose">{data.description}</span>
    </p>
  )
}
