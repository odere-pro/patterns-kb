---
// The nested heading list inside the TOC. Recursive through Astro.self.
//
// Written rather than imported: Starlight's equivalent lives in
// `components-internals/`, which its package.json does not export, and reaching
// past a package's export map is how a minor upgrade turns into a broken build.

/** Starlight's `toc.items`, described structurally — the type is not exported. */
export interface TocEntry {
  slug: string;
  text: string;
  children: TocEntry[];
}

interface Props {
  items: TocEntry[];
  depth?: number;
}

// The depth is an attribute, not an inline style: every value lives in CSS,
// and there are only ever a handful of levels (Starlight's default TOC is
// h2–h3). A comment here rather than in the markup, which would ship it in
// every built page.
const { items, depth = 0 } = Astro.props;
---

<ul class="kb-toc-list" data-depth={depth}>
  {
    items.map((item) => (
      <li>
        <a href={`#${item.slug}`}>{item.text}</a>
        {item.children.length > 0 && <Astro.self items={item.children} depth={depth + 1} />}
      </li>
    ))
  }
</ul>
