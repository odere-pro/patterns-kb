---
// The right-hand "On this page" list, replacing Starlight's own.
//
// Same data, same place in the layout, no <script>. Upstream's version ships a
// module that tracks the reading position, which toc-tracking.client.ts
// already does — and a module never runs from file://, so on a downloaded copy
// upstream's is inert and the kb bundle does the work, while over HTTP
// upstream's wins and the bundle idles. One element, one implementation:
// this override is how that is true on both protocols.
//
// The element is `<nav data-kb-toc>`, deliberately NOT `<starlight-toc>`:
// Starlight's mobile TOC script, which this site keeps, calls
// customElements.define('starlight-toc', …) as a side effect of its import, so
// keeping the tag would have let upstream's behaviour back in through the side
// door on the very element this override exists to free.
import TocList from './TocList.astro';

const { toc } = Astro.locals.starlightRoute;
---

{
  toc && (
    <nav data-kb-toc data-kb-skip class="kb-toc" aria-labelledby="starlight__on-this-page">
      {/* A <p>, not a heading: the rail is chrome and renders before the
          page's <h1>, so a heading here sits ahead of the title in every
          page's outline. The nav is still named by it via aria-labelledby. */}
      <p id="starlight__on-this-page" class="kb-toc-title">
        {Astro.locals.t('tableOfContents.onThisPage')}
      </p>
      <TocList items={toc.items} />
    </nav>
  )
}
