---
// The "View source" link in a page's controls row: it opens the markdown file
// the page is built from. The href is the page's own route with `.md` for
// `.html`, which the post-build pass ships beside the page
// (tools/src/site/site-portable.ts, copySources) and makes depth-relative like
// every other root-absolute link, so it opens from a folder as well as from a
// server. A plain anchor: no script, nothing remembered. Markup only; the
// classes are in view-source.css.
interface Props {
  /** The page's built route, `/a/b.html`. */
  route: string;
  /** The file under docs/ the page is mirrored from, named in the tooltip. */
  source: string | null;
}

const { route, source } = Astro.props;
const href = route.replace(/\.html$/, '.md');
---

<a class="kb-view-source" href={href} title={`Markdown source: ${source ?? href}`}>
  <svg class="kb-view-source-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
    <path d="M14 3v5h5" />
    <path d="M9 13h6M9 17h4" />
  </svg>
  <span>View source</span>
</a>
