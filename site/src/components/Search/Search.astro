---
// The search box: the header button, and the empty dialog the results fill
// (spec kb.pagedata.search, search-box).
//
// This is Starlight's `Search` slot. Upstream renders a button that opens a
// Pagefind dialog, and Pagefind's runtime fetches an index — impossible from a
// folder, which is why the site config sets `pagefind: false` and why this
// override renders no upstream dialog.
//
// The frame is markup and the results are not: rows are built by
// search.client.ts from `window.kb`, the classic script
// tools/src/site/gen-search-index.ts writes in postbuild, ranked by
// tools/src/lib/search-score.ts. So a built page carries no copy of the
// site's other pages.
//
// Everything here is chrome, so it carries data-kb-skip. The combobox wiring
// ships in the markup and its state does not: `aria-expanded` starts false,
// because an empty list is a collapsed one, and the client sets it from the
// rows on every render. The note is the live region — `role="status"`, never
// the `hidden` attribute, because hidden content is announced to nobody.
---

<button type="button" class="kb-search-open" data-kb-search-open data-kb-skip aria-label="Search this site">
  <svg
    aria-hidden="true"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="11" cy="11" r="7"></circle>
    <path d="m20 20-3.5-3.5"></path>
  </svg>
  <span class="kb-search-open-label">Search</span>
  <kbd class="kb-search-open-key" data-kb-search-hint>Ctrl K</kbd>
</button>

<dialog class="kb-search-dialog" data-kb-search-dialog aria-label="Search this site" data-kb-skip>
  <form class="kb-search-form" role="search">
    <svg
      class="kb-search-form-icon"
      aria-hidden="true"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m20 20-3.5-3.5"></path>
    </svg>
    <input
      class="kb-search-input"
      data-kb-search-input
      type="search"
      name="q"
      autocomplete="off"
      spellcheck="false"
      placeholder="Search by name or by what went wrong…"
      aria-label="Search query"
      role="combobox"
      aria-expanded="false"
      aria-controls="kb-search-results"
      aria-autocomplete="list"
    />
    <button type="button" class="kb-search-close" data-kb-search-close aria-label="Close search">
      <kbd>Esc</kbd>
    </button>
  </form>

  <div class="kb-search-body">
    <div class="kb-search-terms" data-kb-search-terms></div>
    <ul class="kb-search-results" id="kb-search-results" data-kb-search-results role="listbox" aria-label="Results"></ul>
    <div class="kb-search-terms" data-kb-search-more></div>
    <p class="kb-search-note kb-visually-hidden" data-kb-search-note role="status" aria-atomic="true"></p>
  </div>

  <footer class="kb-search-foot">
    <span><kbd>↑</kbd><kbd>↓</kbd> to move</span>
    <span><kbd>Enter</kbd> to open</span>
  </footer>
</dialog>
