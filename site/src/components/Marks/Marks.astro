---
// "My marks": the page body that lists every page the reader starred, the
// editors' picks starred for everyone, and every page marked practiced, across
// all hubs, with Export, Import and Reset.
//
// The shell ships empty. marks.client.ts reads the two stores
// (src/lib/store.ts) and the search payload the site already ships, then
// draws the lists, because what a reader marked exists only in their browser.
// Controls and an empty list, not knowledge, but inside the knowledge region,
// where nothing may be skip-marked: a reader reads through them as decoration.
// They do nothing with no script, so the noscript rule in Head.astro hides
// them. Markup only; the classes are in marks.css.
---

<div class="kb-marks not-content" data-kb-marks>
  <p class="kb-marks-lead">
    Mark a page practiced when you have used it in real work. Your stars and checks stay in this browser; the editors' picks are starred for every reader.
  </p>
  <div class="kb-marks-actions" role="group" aria-label="Your marks">
    <button type="button" class="kb-marks-button" data-kb-marks-export>Export</button>
    <button type="button" class="kb-marks-button" data-kb-marks-import>Import</button>
    <input type="file" hidden accept="application/json,.json" aria-label="Marks file" data-kb-marks-file />
    <button type="button" class="kb-marks-button kb-marks-button--danger" data-kb-marks-reset>Reset</button>
  </div>
  <p class="kb-marks-message" data-kb-marks-message role="status" aria-live="polite"></p>
  <h2 id="favourites">Favourites</h2>
  <h3 id="yours">Yours</h3>
  <ul class="kb-marks-list" data-kb-marks-list="favourites"></ul>
  <h3 id="suggested">Suggested</h3>
  <p class="kb-marks-note">The editors' picks. Unstar one on its page and it leaves this list.</p>
  <ul class="kb-marks-list" data-kb-marks-list="suggested"></ul>
  <h2 id="practiced">Practiced</h2>
  <ul class="kb-marks-list" data-kb-marks-list="practiced"></ul>
  <h2 id="no-longer-in-the-site" data-kb-marks-gone-head hidden>No longer in the site</h2>
  <ul class="kb-marks-list" data-kb-marks-list="gone" hidden></ul>
</div>
