---
// Wraps markup that carries no knowledge so a machine reader can drop it whole.
//
// Reach for this only when the attribute cannot go on the element itself: a
// component someone else renders, a slot filled from MDX, a run of decorative
// markup with no single root. When you own the root element, put
// `data-kb-skip` on it directly — a wrapper is one more node in the page text,
// and the page text is the product (.claude/rules/page-schema.md).
//
// `display: contents` keeps the wrapper out of the layout entirely: children
// lay out exactly as they would have without it, so shielding something never
// changes how it looks.
interface Props {
  /** Why this subtree carries no knowledge. Shown to no one; read in review. */
  reason: string;
}
const { reason } = Astro.props;
---

<div class="kb-shield" data-kb-skip data-kb-shield-reason={reason}><slot /></div>
