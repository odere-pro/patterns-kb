---
// "Mentioned by": the pages whose prose links here without declaring a typed
// relation, built on every build from every published page's markdown
// (tools/src/lib/site-mentions.ts). Rendered by MarkdownContent after the
// knowledge region, so it is chrome — skip-marked for a machine reader, which
// reads the same links on the pages that make them. A page nobody mentions
// gets nothing. Markup only; the classes are in mentioned-by.css.
import { loadMentions } from '../../../../tools/src/lib/site-mentions';
import { repoRoot } from '../../lib/repo-root';
import { routeOf } from '../../lib/routes';

interface Props {
  /** The page's route; the current page's when absent. */
  route?: string;
}

const route = Astro.props.route ?? routeOf(Astro.locals.starlightRoute.entry.filePath);
const from = route === null ? [] : (loadMentions(repoRoot()).get(route) ?? []);
---

{
  from.length > 0 && (
    <aside class="kb-mentions" id="mentioned-by" aria-labelledby="mentioned-by-title" data-kb-skip>
      <h2 class="kb-mentions-title" id="mentioned-by-title">Mentioned by</h2>
      <p class="kb-mentions-lead">These pages link here from their prose without declaring a typed relationship.</p>
      <ul class="kb-mentions-list">
        {from.map((p) => (
          <li>
            <a href={p.route}>{p.title}</a> <span class="kb-mentions-kind">{p.kindLabel}</span>
          </li>
        ))}
      </ul>
    </aside>
  )
}
