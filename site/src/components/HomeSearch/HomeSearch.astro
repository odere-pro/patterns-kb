---
// The home page's search prompt: a line saying what the box takes, and one
// example symptom that opens the search dialog already filled in.
//
// The button is Search's own hook (`data-kb-search-open`) plus the text to put
// in the field (`data-kb-search-prefill`); search.client.ts does the opening, so
// this file is markup only and ships no script. The classes are in
// home-search.css. With no script the button does nothing, so the noscript rule
// in Head.astro hides it. The wrapper's id is the address the not-found page's
// "search" link opens: that page loads no script, so it sends the reader here.
interface Props {
  /** The symptom the button offers; a reader who clicks it sees its results at once. */
  example?: string;
}

const { example = 'one slow dependency blocks my threads' } = Astro.props;
---

<div class="kb-home-search not-content" id="search">
  <span class="kb-home-search-prompt">Search by name, or by what went wrong. Try</span>
  <button type="button" class="kb-home-search-example" data-kb-search-open data-kb-search-prefill={example}>
    {`“${example}”`}
  </button>
</div>
