---
// The one override that gives every page the same opening: breadcrumb trail,
// then Starlight's own title, then the injected intro (the purpose line).
// Pages carry no markup for any of it — the standard is the layout's job, and
// site/CLAUDE.md says never to hand-roll it per page.
//
// The home page is the root, and the root has neither a trail nor a title
// block (spec blocks-C6): it gets Starlight's title alone, with no
// purpose line, since its own words follow straight after. Starlight's
// splash template does render this component, so the rule is kept here, by
// route.
//
// Under the intro, on a page (not a hub, not the home page), the reader's own
// controls: the favourite star, the practiced check and the link to the
// page's markdown source.
// Chrome, skip-marked, and outside the knowledge region like the rest of the
// title; on a theme page, which is a tour, the same row of chrome carries
// "n of m practiced" for the tour's pages, counted in the browser from the page
// list baked in here. The row stays in view under the header as the page scrolls
// (page-title.css). A hub carries the star and the check on its rows instead.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import Breadcrumbs from '../Breadcrumbs/Breadcrumbs.astro';
import Favourites from '../Favourites/Favourites.astro';
import PageIntro from '../PageIntro/PageIntro.astro';
import Practiced from '../Practiced/Practiced.astro';
import ViewSource from '../ViewSource/ViewSource.astro';
import { isPage, NOT_FOUND, routeOf } from '../../lib/routes';
import { readTours, tourAt } from '../../lib/tours';
import { sourceOf } from '../../lib/git-date';

const { entry } = Astro.locals.starlightRoute;
const route = routeOf(entry.filePath);
const root = route === '/index.html';
// The not-found page has no trail to follow and no purpose line, but its title
// sits in the class-free head block every page but the home page carries.
const notFound = route === NOT_FOUND;
const slug = route === null ? '' : (route.split('/').pop() as string).replace(/\.html$/, '');
const page = isPage(route);
const tour = tourAt(readTours(), route);
const authored = (entry.data as { favourite?: boolean }).favourite === true;
---

{/* The trail is chrome; the title and intro are knowledge. The class-free
    data-page-head wrapper is the region's data block — a machine reader keeps
    what is under it and drops the skipped trail (page-schema.md). */}
{
  root ? (
    <Default />
  ) : notFound ? (
    <div data-page-head>
      <Default />
    </div>
  ) : (
    <>
      <Breadcrumbs />
      <div data-page-head>
        <Default />
        <PageIntro />
      </div>
    </>
  )
}
{tour !== undefined && <Practiced tour={tour.slugs} />}
{
  page && (
    <div class="kb-page-actions" data-kb-skip>
      <Favourites slug={slug} name={entry.data.title} authored={authored} />
      <Practiced slug={slug} name={entry.data.title} />
      <ViewSource route={route as string} source={sourceOf(entry.filePath)} />
    </div>
  )
}
