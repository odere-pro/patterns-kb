---
// Starlight's own wrapper around a page's rendered body, plus the one hook
// attribute that names it the knowledge region (spec blocks-C11). The post-build
// pass wraps what is inside it in the article block, and every program that
// reads a built page finds the region by this attribute, never by Starlight's
// class name, which is upstream's to change.
//
// At the top of the region, and so inside it: the prerequisite card
// (PrerequisiteCard), knowledge read from docs/data/prerequisites.json, on a
// page whose record has an edge. After the region, and so outside it: the
// "Mentioned by" aside, built from other pages' prose links (MentionedBy),
// chrome a machine reader skips.
import '@astrojs/starlight/style/markdown.css';
import MentionedBy from '../MentionedBy/MentionedBy.astro';
import PrerequisiteCard from '../PrerequisiteCard/PrerequisiteCard.astro';
---

<div class="sl-markdown-content" data-kb-region><PrerequisiteCard /><slot /></div>
<MentionedBy />
