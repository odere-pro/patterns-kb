---
// The header's right-hand cluster. Starlight renders the social links here and
// the theme control next to it, which makes this the one override that can add
// a header button without taking ownership of the whole Header component.
// Beside it, the link to the marks page (src/pages/marks.astro): plain markup,
// so it works with no script.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
import PageMeta from '../PageMeta/PageMeta.astro';
---

<a class="kb-marks-link" href="/marks.html" data-kb-skip>My marks</a>
