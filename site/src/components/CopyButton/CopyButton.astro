---
// One command, and a control that puts it on the clipboard.
//
// Markup only. The write, the whitespace normalisation and the two seconds of
// feedback are in copy.client.ts, and reach the page inside the one kb bundle.
//
// The chip and the button are siblings rather than the chip being inside the
// button, and that is the load-bearing decision here. A button wrapping the
// command would be a bigger target, but `.kb-copy` is in the one <noscript>
// rule Head emits, and hiding a button that contained the command would take
// the command off the page with it. Side by side, a reader with no scripts
// still has the command to read and select by hand.
//
// The value is not repeated into a `data-` attribute for the module to read.
// It reads the chip's own text and collapses the whitespace, which is the same
// step that makes the copy correct: `dist` is pretty-printed, so a cell's
// textContent carries the formatter's newlines and indentation, and a copy
// that trusted it would paste them too.
//
// `aria-label` carries the command rather than a bare "Copy", because a table
// of twenty commands is twenty identically-named buttons to a screen reader.
//
// `data-kb-copy` sits on the wrapper rather than on the button, and it is the
// hook copy.client.ts listens for — behaviour is always an attribute, never a
// class (page-schema.md). On the wrapper it also states the click target: the
// command is the obvious thing to click and a far bigger one than the button.
// `block` is for a pair that shares a box with prose — the catalog's cells put
// the command on its own line above the sentence, and an inline-flex span there
// would let the sentence start beside the button.
interface Props {
  /** The command, exactly as it should land on the clipboard. */
  value: string;
  /** Take a line of its own instead of sitting inline. */
  block?: boolean;
}

const { value, block } = Astro.props;
const rootClass = block ? 'kb-copyable kb-copyable--block' : 'kb-copyable';
---

<span class={rootClass} data-kb-copy>
  <code class="kb-code-chip">{value}</code>
  <button type="button" class="kb-copy" aria-label={`Copy ${value}`} title="Copy">
    <svg class="kb-copy-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="8" y="8" width="14" height="14" rx="2" ry="2" />
      <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
    </svg>
    <svg class="kb-copy-done" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="m5 13 4 4L19 7" />
    </svg>
  </button>
  <span class="kb-copy-note kb-visually-hidden" role="status" aria-atomic="true"></span>
</span>
