---
// Replaces Starlight's ThemeSelect dropdown with one button that cycles
// auto → dark → light, wearing the state as its icon.
//
// Markup only. The cycle, the storage key and the `''`-means-auto convention
// live in theme-toggle.client.ts and ../../lib/theme.ts, and reach the page
// inside the one kb bundle — a module script never runs from file://, which
// is what made the dropdown this replaces inert on disk.
---

<button
  type="button"
  class="kb-theme-toggle"
  data-kb-theme-toggle
  data-kb-skip
  data-state="auto"
  title="Theme: auto"
  aria-label="Theme: auto — click to change"
>
  <svg class="kb-theme-icon-light" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <circle cx="12" cy="12" r="4.5" />
    <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1" />
  </svg>
  <svg class="kb-theme-icon-dark" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
  </svg>
  <svg class="kb-theme-icon-auto" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <circle cx="12" cy="12" r="9" />
    <path d="M12 3a9 9 0 0 0 0 18Z" fill="currentColor" stroke="none" />
  </svg>
</button>
