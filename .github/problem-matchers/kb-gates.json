{
  "problemMatcher": [
    {
      "owner": "kb-rule",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^([A-Z]+-[0-9]+) ([^\\s:]+):([0-9]+) (.+)$",
          "code": 1,
          "file": 2,
          "line": 3,
          "message": 4
        }
      ]
    },
    {
      "owner": "kb-gate",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^\\[([a-z0-9-]+)\\] FAIL ([^\\s:]+): (.+)$",
          "code": 1,
          "file": 2,
          "message": 3
        }
      ]
    },
    {
      "owner": "kb-gate-line",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^\\[([a-z0-9-]+)\\] FAIL ([^\\s:]+):([0-9]+): (.+)$",
          "code": 1,
          "file": 2,
          "line": 3,
          "message": 4
        }
      ]
    }
  ]
}
