{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(node scripts/kb.mjs:*)",
      "Bash(node .claude/skills/kb-fact-check/fetch.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(node --check:*)",
      "Bash(node --test:*)",
      "Bash(bash tests/run.sh)",
      "Bash(node .claude/skills/kb-harvest/harvest.mjs:*)",
      "Bash(node .claude/skills/site-extract/structure.mjs:*)",
      "Bash(node .claude/skills/kb-fact-check/eval-check.mjs:*)",
      "Bash(node .claude/skills/kb-fact-check/merge-staged.mjs:*)",
      "Bash(node .claude/skills/kb-fact-check/rollup.mjs:*)",
      "Bash(jq:*)",
      "Bash(comm:*)",
      "Bash(sort:*)",
      "Bash(wc:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(git grep:*)",
      "Bash(git blame:*)",
      "Bash(mkdir -p tmp/designs/)"
    ],
    "deny": [
      "Edit(/site/dist/**)",
      "Edit(/site/.astro/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/after-write.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-commands.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
